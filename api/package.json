{
  "name": "aem-crm-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsc-watch --noClear -p tsconfig.json --onSuccess \"node dist/server.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "ts-node src/seed.ts",
    "clone:contractor": "ts-node src/scripts/clone-contractor.ts",
    "backfill:doc-numbers": "ts-node src/scripts/backfill-document-numbers.ts",
    "backfill:record-numbers": "ts-node src/scripts/backfill-document-numbers.ts",
    "db:account-verifications": "ts-node src/scripts/apply-account-verification-columns.ts",
    "db:lookup-options": "ts-node src/scripts/apply-lookup-options-table.ts",
    "db:audit-columns": "ts-node src/scripts/apply-audit-columns.ts",
    "db:job-address": "ts-node src/scripts/apply-job-address-columns.ts",
    "db:job-expense-category": "ts-node src/scripts/apply-job-expense-category-column.ts",
    "db:job-activity-payments": "ts-node src/scripts/apply-job-activity-and-invoice-payments.ts",
    "db:job-time-entries": "ts-node src/scripts/apply-job-time-entry-columns.ts",
    "db:notification-target-url": "ts-node src/scripts/apply-notification-target-url-column.ts",
    "db:ticket-numbers": "ts-node src/scripts/apply-ticket-numbers.ts",
    "db:compliance-renewal-value": "ts-node src/scripts/apply-compliance-expected-renewal-value-column.ts",
    "db:tenant-ui-preferences": "ts-node src/scripts/apply-tenant-ui-preferences-column.ts",
    "db:planner-entries": "ts-node src/scripts/apply-planner-entries.ts",
    "db:planner-note-reminders": "ts-node src/scripts/apply-planner-note-reminders.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.15.0",
    "bullmq": "^5.9.3",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.21",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.13.7",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "tsc-watch": "^6.2.0",
    "typescript": "^5.6.3"
  }
}
